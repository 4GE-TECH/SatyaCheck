# Copy to .env (git-ignored) and fill in. Never commit real values.
# config.py loads .env at startup (not under pytest); real environment variables win.

# --- Environment -------------------------------------------------------------------
# "production" forces AUTH_MODE=jwt, turns off LEGACY_NPZ_FALLBACK and the local copy of
# call audio (RETAIN_SESSION_AUDIO).
SATYACHECK_ENV=dev

# --- Database (Supabase Postgres) --------------------------------------------------
# Admin (the `postgres` user, Connect -> Session pooler). Migrations and the daily
# retention sweep only:
#   alembic -c server/migrations/alembic.ini upgrade head
#   python -m server.retention
DATABASE_ADMIN_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Password the migration gives the app role (satyacheck_app). Pick a long random one.
SATYACHECK_APP_DB_PASSWORD=
# What the backend connects as: the app role, which row-level security filters.
# Leave empty to stay on the local SQLite file (data/satyacheck.db).
DATABASE_URL=
# e.g. postgresql://satyacheck_app.<ref>:<app password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Auth (Supabase) -----------------------------------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
# "dev": requests without a token act as DEV_OWNER_ID (never in production). "jwt": every
# request needs a Supabase access token.
AUTH_MODE=dev

# --- Telephony -----------------------------------------------------------------------
# The account (Supabase user id) that owns calls arriving from Exotel. Required in jwt mode.
EXOTEL_OWNER_ID=

# --- App-to-app calls (WebRTC / LiveKit; webrtc/README.md) ----------------------------
# Mounted only with AUTH_MODE=jwt. The key and secret must match the LiveKit server's.
# Comments go on their own lines: the .env reader keeps everything after "=".
ENABLE_WEBRTC=false
# What phones connect to:
LIVEKIT_URL=ws://<LAN or public IP>:7880
# What the backend's screening agent connects to:
LIVEKIT_AGENT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
# 32+ random characters; never commit it:
LIVEKIT_API_SECRET=
# Where the models run: auto (GPU when present) | cuda | cpu
# SATYACHECK_DEVICE=auto

# --- Operations ----------------------------------------------------------------------
# Bearer token a Prometheus scrape of /metrics must send. Production serves /metrics only
# with one. The endpoint carries aggregate counts and timings, never call data.
METRICS_TOKEN=
# Model weights somewhere other than ./models (a mounted volume, for example).
# SATYACHECK_MODELS_DIR=

# --- Web and mobile sign-in (build time, public values) --------------------------------
# web3:   VITE_SUPABASE_URL=https://<ref>.supabase.co  VITE_SUPABASE_ANON_KEY=<anon key>
# mobile: --dart-define=SATYACHECK_SUPABASE_URL=...  --dart-define=SATYACHECK_SUPABASE_ANON_KEY=...

# --- Tests ---------------------------------------------------------------------------
# Admin URL the Postgres RLS tests (server/tests/test_rls_postgres.py) migrate a throwaway
# schema into. Can be the same project as DATABASE_ADMIN_URL; the tests use their own
# schema and role and drop the schema afterwards.
TEST_DATABASE_ADMIN_URL=
